# Defaults to a durable local simulator. No wallet is needed.
PERPOPS_MODE=simulation
PERPOPS_PORT=4317
# PERPOPS_DATA_DIR=.data/simulation

# Dedicated testnet account only. Mainnet is deliberately unsupported.
# PERPOPS_MODE=dreamdex
# PERPOPS_ACCOUNT=0x_your_testnet_account
# PERPOPS_PRIVATE_KEY=0x_your_disposable_testnet_key
# PERPOPS_TESTNET_TRADING=1
# PERPOPS_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# NODE_USE_ENV_PROXY=1
